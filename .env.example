# Copiar a .env y llenar. Astro solo expone al navegador las que empiezan con PUBLIC_.

# Webhook unico para los 3 formularios (Zapier / Make / n8n).
# Ese endpoint reparte a Neo CRM + Google Sheet.
PUBLIC_WEBHOOK_URL=

# Meta. Pendiente de Salem: falta el Dataset/Pixel ID.
PUBLIC_META_PIXEL_ID=

# reCAPTCHA v3. Pendiente: site key desde la cuenta de Google del cliente.
# La secret key NO va aqui, va en la herramienta de automatizacion.
PUBLIC_RECAPTCHA_SITE_KEY=

# Si esta en "true" el pixel espera al consentimiento de cookies.
PUBLIC_REQUIRE_COOKIE_CONSENT=true
