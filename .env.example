# Copiar a .env y llenar. Astro solo expone al navegador las que empiezan con PUBLIC_.
#
# NUNCA poner aqui el access token de la CAPI ni la secret key de reCAPTCHA.
# Todo lo PUBLIC_ queda incrustado en el bundle y visible en el codigo fuente.
# Esos dos secretos van del lado servidor, en la herramienta de automatizacion.

# URL publica de ESTE despliegue. De aqui salen el canonical y el og:image.
# No es el dominio del cliente: mientras la landing viva en Cloudflare va la
# URL de pages.dev, y el dia del lanzamiento se cambia al subdominio real.
PUBLIC_SITE_URL=https://jk-landing-v1.pages.dev

# En "false" (o sin definir) todas las paginas van en noindex, robots.txt
# bloquea el rastreo y no se publica la ficha AutoDealer. Se pone en "true"
# el dia del lanzamiento, no antes.
PUBLIC_ALLOW_INDEXING=false

# Webhook unico para los 3 formularios (Zapier / Make / n8n).
# Ese endpoint reparte a Neo CRM + Google Sheet.
# Sin esto el formulario falla a la vista, a proposito: antes fingia que el
# envio habia salido bien y el lead se perdia.
PUBLIC_WEBHOOK_URL=

# Meta. Pendiente de Salem: falta el Dataset/Pixel ID.
# Son 15-16 digitos. NO es el access token.
PUBLIC_META_PIXEL_ID=

# reCAPTCHA v3. Pendiente: site key desde la cuenta de Google del cliente.
# La secret key NO va aqui, va en la herramienta de automatizacion.
PUBLIC_RECAPTCHA_SITE_KEY=

# Si esta en "true" el pixel espera al consentimiento de cookies.
PUBLIC_REQUIRE_COOKIE_CONSENT=true
