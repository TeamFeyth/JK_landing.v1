---
/* Hero. Izquierda: titular y bullets. Derecha: formulario, pegado en desktop.
   El formulario es el ancla visual, no un accesorio.

   El unico boton primario de esta pantalla es el submit del formulario.
   El copy del cliente listaba ademas un CTA "Get Pre-Approved" arriba del
   formulario, pero serian dos primarios en la misma vista y la guia lo prohibe.

   Fondo: foto real del lote con el velo negro al 55% que pide la guia.
   La imagen se define en site.ts. Si la foto no carga (el CDN del DMS podria
   activar proteccion de hotlinking, o venderse el auto), abajo queda el panel
   Ink solido y la seccion se ve igual de bien: la imagen es decorativa, nunca
   carga texto. */
import { copy } from '../data/copy';
import { site } from '../data/site';
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';
---

<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 class="t-hero hero-headline">
        <span class="bi-en" lang="en">{copy.hero.headline.en}</span>
        <span class="bi-es" lang="es">{copy.hero.headline.es}</span>
      </h1>

      <p class="t-body-lg hero-sub prose">
        <span class="bi-en" lang="en">{copy.hero.sub.en}</span>
        <span class="bi-es" lang="es">{copy.hero.sub.es}</span>
      </p>

      <ul class="hero-bullets">
        {
          copy.hero.bullets.map((b) => (
            <li>
              <Icon name="shield" size={20} class="hero-bullet-icon" />
              <span>
                <span class="bi-en" lang="en">{b.en}</span>
                <span class="bi-es" lang="es">{b.es}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-form">
      <LeadForm
        source="hero"
        headline={copy.form.heroHeadline}
        sub={copy.form.heroSub}
        headingTag="h2"
      />
    </div>
  </div>
</section>

<style define:vars={{ heroImg: `url("${site.heroImage}")`, heroImgSm: `url("${site.heroImageSmall}")` }}>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--heroImgSm);
    background-size: cover;
    background-position: center;
  }
  /* Velo al 55% sobre la foto. Sin esto el texto blanco no alcanza contraste */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(17, 20, 24, 0.55);
  }
  @media (min-width: 768px) {
    .hero-bg { background-image: var(--heroImg); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-bg { background-attachment: scroll; }
  }

  .hero {
    position: relative;
    isolation: isolate;
    /* Respaldo solido: si la foto no llega, esto es lo que se ve */
    background: var(--c-ink);
    color: var(--c-white);
    padding-block: var(--s-12);
  }
  .hero-grid { display: grid; gap: var(--s-12); }
  .hero-headline { margin-bottom: var(--s-6); }
  .hero-sub { color: rgba(255, 255, 255, 0.85); margin-bottom: var(--s-8); }

  .hero-bullets { display: grid; gap: var(--s-4); }
  .hero-bullets li { display: flex; align-items: flex-start; gap: var(--s-3); }
  .hero-bullet-icon { color: var(--c-red); flex-shrink: 0; margin-top: 2px; }

  @media (min-width: 900px) {
    .hero { padding-block: var(--s-24); }
    .hero-grid {
      grid-template-columns: 1fr minmax(380px, 440px);
      gap: var(--gutter);
      align-items: start;
    }
    .hero-form {
      position: sticky;
      top: calc(var(--header-h) + var(--s-6));
    }
  }
</style>
