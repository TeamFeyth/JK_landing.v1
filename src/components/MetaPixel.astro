---
/* Pixel de Meta.

   ESTE ES EL UNICO LUGAR donde se inicializa el pixel. No volver a pegar el
   snippet de Meta en un layout ni en una pagina: el snippet oficial arranca
   con "if (f.fbq) return", asi que el primero que corra gana y el resto se
   ignora en silencio. Un snippet con el ID escrito a mano en el <head> deja
   PUBLIC_META_PIXEL_ID sin efecto y nadie se entera.

   El ID sale de PUBLIC_META_PIXEL_ID (Cloudflare). Si no esta definida, el
   pixel no carga.

   Solo carga en el dominio de PUBLIC_SITE_URL, para que los deploys de
   preview y localhost no ensucien el dataset de produccion.

   Si PUBLIC_REQUIRE_COOKIE_CONSENT es "true", el pixel espera al evento
   jk:consent que dispara el banner de cookies.

   El evento Lead se dispara en /thank-you con el eventID que viaja en la URL,
   para que la CAPI pueda deduplicar contra el mismo identificador. */
import { META_PIXEL_ID, REQUIRE_COOKIE_CONSENT, SITE_URL } from '../lib/config';

const pixelId = META_PIXEL_ID;
const requireConsent = REQUIRE_COOKIE_CONSENT;
const siteUrl = SITE_URL;
---

{
  pixelId && (
    <script is:inline define:vars={{ pixelId, requireConsent, siteUrl }}>
      (function () {
        /* Sin PUBLIC_SITE_URL no se bloquea nada: se asume un solo dominio y
           se mantiene el comportamiento anterior. */
        function hostAutorizado() {
          if (!siteUrl) return true;
          try {
            return window.location.hostname === new URL(siteUrl).hostname;
          } catch (e) {
            return true;
          }
        }

        if (!hostAutorizado()) return;

        function loadPixel() {
          if (window.fbq) return;
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
          n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
          (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
          window.fbq('init', pixelId);
          window.fbq('track', 'PageView');
        }

        if (!requireConsent) { loadPixel(); return; }

        var stored = null;
        try { stored = localStorage.getItem('jk_cookie_consent'); } catch (e) {}
        if (stored === 'granted') loadPixel();
        else window.addEventListener('jk:consent', function (e) {
          if (e.detail === 'granted') loadPixel();
        });
      })();
    </script>
  )
}
