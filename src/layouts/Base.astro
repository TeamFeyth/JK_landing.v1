---
/* Tipografias auto-hospedadas. Evita la peticion a Google Fonts, que pesa
   en el LCP y por lo tanto en el ranking de calidad de los anuncios de Meta. */
import '@fontsource-variable/archivo';
import '@fontsource-variable/archivo/wght-italic.css';
import '@fontsource/archivo-black';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

import Captcha from '../components/Captcha.astro';
import MetaPixel from '../components/MetaPixel.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = '', noindex = false } = Astro.props;

/* El canonical va contra la URL de ESTE despliegue (Astro.site, que sale de
   PUBLIC_SITE_URL), no contra el dominio del cliente. Antes apuntaba a
   jkamalcars.com y le decia a Google que esta pagina era una copia de la
   home del cliente. */
const origin = Astro.site ?? new URL(site.domain);
const canonical = new URL(Astro.url.pathname, origin).href;

/* Mientras esto no sea "true", TODAS las paginas van en noindex. Evita que
   el subdominio de pruebas se indexe con la marca, el telefono y la ficha
   AutoDealer del cliente, compitiendo con su sitio real. Se enciende el dia
   del lanzamiento, junto con robots.txt. */
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true';
const blockIndex = noindex || !allowIndexing;

/* Ficha del negocio para Google. Los datos salen de site.ts, o sea que
   cambiarlos en un solo lugar actualiza tambien esto. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  name: site.name,
  url: site.domain,
  telephone: site.phoneDisplay,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
  sameAs: site.social,
  openingHoursSpecification: site.hours
    .filter((h) => !h.closed)
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: `https://schema.org/${h.en}`,
      opens: '09:00',
      closes: h.en === 'Saturday' ? '17:00' : '19:00',
    })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {blockIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {
      site.ogImage && (
        <meta property="og:image" content={new URL(site.ogImage, Astro.site ?? site.domain).href} />
      )
    }
    <meta name="twitter:card" content={site.ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      /* La ficha AutoDealer solo se publica cuando la pagina es indexable.
       Dos fichas del mismo negocio en URLs distintas le ensucian a Google
       el panel local del cliente. */
    }
    {
      !blockIndex && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
      )
    }

    <MetaPixel />
    <Captcha />
  </head>

  <body>
    <slot />
  </body>
</html>
