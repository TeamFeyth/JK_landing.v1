---
/* Pagina de gracias. Aqui se dispara el evento Lead del pixel:
   una URL propia es la senal mas limpia y no cuenta envios fallidos.

   El event_id llega en el parametro eid y se manda como eventID del pixel.
   Es el mismo valor que la funcion escribe en el ADF, asi que la CAPI puede
   deduplicar contra el. Un recargado no vuelve a contar el evento. */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { copy } from '../data/copy';
---

<Base title={copy.thanks.title} noindex>
  <Header />

  <main class="thanks">
    <div class="wrap thanks-inner">
      <h1 class="t-h1 thanks-title">
        <span class="bi-en" lang="en">{copy.thanks.headline.en}</span>
        <span class="bi-es" lang="es">{copy.thanks.headline.es}</span>
      </h1>

      <p class="t-body-lg thanks-sub prose">
        <span class="bi-en" lang="en">{copy.thanks.sub.en}</span>
        <span class="bi-es" lang="es">{copy.thanks.sub.es}</span>
      </p>

      <a class="btn btn-secondary btn-md" href="/">{copy.thanks.back}</a>
      <span class="btn-es">{copy.thanks.backEs}</span>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .thanks {
    padding-block: var(--s-24);
  }
  .thanks-inner {
    max-width: var(--measure);
  }
  .thanks-title {
    margin-bottom: var(--s-6);
  }
  .thanks-sub {
    color: var(--c-slate);
    margin-bottom: var(--s-8);
  }
</style>

<script>
  const params = new URLSearchParams(window.location.search);
  const source = params.get('source') ?? 'unknown';
  const eventId = params.get('eid') ?? '';

  const ONCE_KEY = `jk_lead_fired_${eventId || source}`;

  function alreadyFired(): boolean {
    if (!eventId) return false;
    try {
      return sessionStorage.getItem(ONCE_KEY) === '1';
    } catch {
      return false;
    }
  }

  function markFired(): void {
    try {
      sessionStorage.setItem(ONCE_KEY, '1');
    } catch {
      return;
    }
  }

  function fire(): boolean {
    if (alreadyFired()) return true;
    const fbq = window.fbq;
    if (typeof fbq !== 'function') return false;

    // Un solo evento estandar Lead. Tres eventos distintos optimizarian peor.
    // El eventID es lo que permite deduplicar contra la CAPI.
    if (eventId) {
      fbq('track', 'Lead', { source }, { eventID: eventId });
    } else {
      fbq('track', 'Lead', { source });
    }

    markFired();
    return true;
  }

  if (!fire()) {
    /* El pixel puede llegar despues del consentimiento de cookies.
       Se reintenta en vez de apostar a un retardo fijo. */
    let tries = 0;
    const timer = window.setInterval(() => {
      if (fire() || ++tries >= 20) window.clearInterval(timer);
    }, 250);
    window.addEventListener('jk:consent', () => fire());
  }
</script>
